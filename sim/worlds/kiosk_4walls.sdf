<?xml version="1.0" encoding="UTF-8"?>
<!--
  4 walls at 3m from the origin (N/E/S/W), each carrying 4 corner ArUco
  markers (DICT_4X4_50, 150mm) so its marked face points at the origin.
  ID sets: north 0-3, east 4-7, south 8-11, west 12-15.
  See sim/generate_marker.py for the marker layout and sim/README.md for the
  yaw-per-wall derivation (wall yaw = wall_position_angle - 90deg so the
  panel's local -Y face, the marked face, points inward).
-->
<sdf version="1.9">
  <world name="kiosk_4walls">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- north (+Y), ids 0-3, yaw 0 -->
    <include>
      <uri>model://kiosk_wall</uri>
      <name>kiosk_wall_north</name>
      <pose>0 3 1.5 0 0 0</pose>
    </include>

    <!-- east (+X), ids 4-7, yaw -90deg so local -Y (marked face) points -X (inward) -->
    <include>
      <uri>model://kiosk_wall_east</uri>
      <name>kiosk_wall_east</name>
      <pose>3 0 1.5 0 0 -1.570796</pose>
    </include>

    <!-- south (-Y), ids 8-11, yaw 180deg so local -Y (marked face) points +Y (inward) -->
    <include>
      <uri>model://kiosk_wall_south</uri>
      <name>kiosk_wall_south</name>
      <pose>0 -3 1.5 0 0 3.141593</pose>
    </include>

    <!-- west (-X), ids 12-15, yaw 90deg so local -Y (marked face) points +X (inward) -->
    <include>
      <uri>model://kiosk_wall_west</uri>
      <name>kiosk_wall_west</name>
      <pose>-3 0 1.5 0 0 1.570796</pose>
    </include>
  </world>
</sdf>
